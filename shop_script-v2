-- Shop Script v2 - Auto-configured, payment-method agnostic
-- Setup:
--   ShopAdmin: 1x product item + stack of payment cards (count = price in cards)
--   ShopStock: items to sell
--   ShopPayment: player payment input
--   ShopPickup: sold items appear here
--   ShopReserve: collected payment storage
--   ShopLCD: display

{{set 'pid' 0}}{{set 'pname' 'Not Configured'}}
{{set 'cid' 0}}{{set 'cname' 'Not Configured'}}
{{set 'price' 0}}{{set 'stock' 0}}
{{set 'totalPay' 0}}{{set 'payOK' false}}
{{set 'moved' false}}{{set 'status' 'Configuring...'}}{{set 'sc' 'white'}}

-- Full logic every 5 cycles
{{#test (calc @root.CycleCounter '%' 5) eq 0}}

  -- Read config from admin box: detect product and payment type
  {{#items E.S 'ShopAdmin'}}
    {{#test Id 'neq' @root.Data.cid}}
      {{#test @root.Data.pid 'eq' 0}}
        {{set 'pid' Id}}{{set 'pname' Name}}
      {{/test}}
    {{/test}}
  {{/items}}

  {{#items E.S 'ShopAdmin'}}
    {{#test Id 'neq' @root.Data.pid}}
      {{set 'cid' Id}}{{set 'cname' Name}}
    {{/test}}
  {{/items}}

  -- Read price from payment stack count in admin box
  {{#items E.S 'ShopAdmin'}}
    {{#test Id 'eq' @root.Data.cid}}
      {{set 'price' Count}}
    {{/test}}
  {{/items}}

  -- Count available stock
  {{#items E.S 'ShopStock'}}
    {{#test Id 'eq' @root.Data.pid}}
      {{#math @root.Data.stock '+' Count}}{{set 'stock' .}}{{/math}}
    {{/test}}
  {{/items}}

  -- Sum all payment in the payment box
  {{set 'totalPay' 0}}
  {{#items E.S 'ShopPayment'}}
    {{#test Id 'eq' @root.Data.cid}}
      {{#math @root.Data.totalPay '+' Count}}{{set 'totalPay' .}}{{/math}}
    {{/test}}
  {{/items}}
  {{#test @root.Data.totalPay 'eq' @root.Data.price}}
    {{set 'payOK' true}}
  {{/test}}

  -- Process transaction
  {{#if @root.Data.payOK}}
    {{#if @root.Data.stock}}
      {{#items E.S 'ShopStock'}}
        {{#test Id 'eq' @root.Data.pid}}
          {{#test @root.Data.moved 'eq' false}}
            {{#move . @root.E.S 'ShopPickup' 1}}{{/move}}
            {{set 'moved' true}}
          {{/test}}
        {{/test}}
      {{/items}}
      {{#if @root.Data.moved}}
        {{#items E.S 'ShopPayment'}}
          {{#test Id 'eq' @root.Data.cid}}
            {{#move . @root.E.S 'ShopReserve' @root.Data.price}}{{/move}}
          {{/test}}
        {{/items}}
        {{set 'status' 'Sold! Check ShopPickup'}}{{set 'sc' 'green'}}
      {{/if}}
    {{else}}
      {{set 'status' 'Out of Stock'}}{{set 'sc' 'red'}}
    {{/if}}
  {{else}}
    {{#if @root.Data.stock}}
      {{set 'status' 'Insert Payment'}}{{set 'sc' 'yellow'}}
    {{else}}
      {{set 'status' 'Out of Stock'}}{{set 'sc' 'red'}}
    {{/if}}
  {{/if}}

{{/test}}

-- LCD Display
{{#devices E.S 'ShopLCD'}}
{{~#each .}}{{~settextblock .}}
<align=center>
<size=22>══════════════════════</size>
<color=yellow><size=30>{{@root.Data.pname}}</size></color>
<size=22>══════════════════════</size>

<color=white>Price: <color=yellow>{{@root.Data.price}}</color> {{@root.Data.cname}}</color>
<color=white>Stock: <color=cyan>{{@root.Data.stock}}</color></color>

<color={{@root.Data.sc}}><size=24>{{@root.Data.status}}</size></color>

<size=14><color=#888>Admin: update ShopAdmin to change</color></size>
{{/settextblock}}{{/each}}{{/devices}}
